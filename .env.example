# Copy to server/.env and fill in real values (never commit .env).

# --- Supabase (from your project's API settings) ---
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # service_role secret, server-only

# --- WhatsApp provider ---
# Which backend sendText() uses: "meta" or "wasender".
# Leave blank to auto-detect: wasender if WASENDER_API_KEY is set, else meta.
WHATSAPP_PROVIDER=

# --- Option A: WasenderAPI (https://wasenderapi.com) ---
WASENDER_API_KEY=               # Bearer token from your connected WhatsApp session
WASENDER_WEBHOOK_SECRET=        # Webhook Secret from the session settings; matched against
                                # the X-Webhook-Signature header on incoming webhooks

# --- Option B: WhatsApp Business Cloud API (Meta developer console) ---
WHATSAPP_TOKEN=                 # Graph API access token
WHATSAPP_PHONE_NUMBER_ID=       # test/sandbox phone number ID
WHATSAPP_VERIFY_TOKEN=orderwise-verify   # any string; must match the value you set in Meta's webhook config

# --- Server ---
PORT=3001

# --- Demo ---
# DEMO: set to your real WhatsApp number (e.g. 923001234567) so the
# phone you test with maps to the first seeded retailer. Falls back to a placeholder.
DEMO_PHONE=923001111111
